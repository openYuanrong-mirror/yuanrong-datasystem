+void NodeImpl::get_leadership_status(LeadershipStatus* status) {
+    if (status == NULL) {
+        return;
+    }
+
+    std::unique_lock<raft_mutex_t> lck(_mutex);
+    status->state = _state;
+    status->term = _current_term;
+    if (_state == STATE_LEADER || _state == STATE_TRANSFERRING) {
+        status->leader_id = _server_id;
+    } else if (_state == STATE_FOLLOWER) {
+        status->leader_id = _leader_id;
+    } else {
+        status->leader_id.reset();
+    }
+}
